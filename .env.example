# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Local test login. Must match [auth.sms.test_otp] in supabase/config.toml, where these
# numbers accept this code and never send a real SMS. Used by the e2e tests and for logging in
# by hand (see README, "Logging in locally").
TEST_PHONE_DRIVER=+15555550100
TEST_PHONE_CARRIER=+15555550101
TEST_PHONE_ADMIN=+15555550102
TEST_OTP=123456
# true: the login and code forms start filled with TEST_PHONE_DRIVER and TEST_OTP.
# Off unless set to exactly "true". A production build refuses to start with it on, unless
# NEXT_PUBLIC_SUPABASE_URL is the local stack. Never set it on a hosted deployment.
ENABLE_TEST_LOGIN=true

# true: the carrier side is hidden. The landing page button, /login?role=carrier, the role
# picker and every /carrier page lead to a "Carriers: coming soon" page (/carriers), and no new
# carrier profile can be created. Off unless set to exactly "true".
CARRIER_DISABLED=false

# Twilio, for the app's own texts (shift offers, Milestone 3). Not used for login codes: those
# are sent and checked by Supabase Auth through the SMS provider set in the Supabase dashboard
# (Twilio Verify until the toll-free number is approved, then the Twilio Messaging Service; see
# README, "Login codes").
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_MESSAGING_SERVICE_SID=

# Stripe (Milestone 2). The app uses Stripe only when the first three are all set; otherwise
# test login gives the in-memory test checkout and production says payments are not set up.
#   STRIPE_SECRET_KEY        Developers > API keys: sk_test_... or a restricted rk_test_... key
#                            with write access to Customers, Checkout Sessions, Customer portal
#                            and Subscriptions
#   STRIPE_WEBHOOK_SECRET    whsec_...: locally from `stripe listen --forward-to
#                            localhost:3000/api/stripe/webhook`; on Vercel from the webhook
#                            endpoint for https://<host>/api/stripe/webhook (they differ)
#   STRIPE_PRICE_ID_MONTHLY  price_... of the $399 a month price (Product catalog)
#   NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY  pk_test_... (Checkout is a redirect, so it is optional)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID_MONTHLY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# A long random string. Vercel Cron sends it as "Authorization: Bearer ..." to the two daily
# jobs in vercel.json: /api/cron/reconcile-subscriptions (re-reads stale subscriptions from
# Stripe in case a webhook was lost) and /api/cron/heartbeat (one cheap database read, so a
# free-tier Supabase project is never paused for inactivity). Unset, both refuse every call.
#   curl -H "Authorization: Bearer <CRON_SECRET>" localhost:3000/api/cron/heartbeat
CRON_SECRET=
# "true" keeps the in-memory test checkout even with the Stripe keys set (browser tests).
# Only works with ENABLE_TEST_LOGIN. Playwright sets it when it starts the server itself.
PAYMENT_TEST_MODE=

# The marketing site. NEXT_PUBLIC_SITE_URL is the canonical host for metadata, the sitemap
# and robots (default https://fleetgridus.com). The two switches show the toll-free number:
# NEXT_PUBLIC_SHOW_PHONE for calls (footer and Contact page), NEXT_PUBLIC_SHOW_SMS_NUMBER as
# the shift-text sender in the footer's texting line. Both are off unless set to exactly
# "true". Leave them off until the client confirms calls are answered and Twilio has
# approved the number.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SHOW_PHONE=false
NEXT_PUBLIC_SHOW_SMS_NUMBER=false
# The Google Ads tag (gtag.js, src/lib/analytics.ts). Unset: the client's tag AW-18533050920
# loads on the production deployment only (never locally, in CI or on previews). An id here
# loads that tag anywhere; "off" loads nothing. The labels are the conversion actions' labels
# from Google Ads (the part after the slash in AW-18533050920/xxxx): the first counts a
# finished driver sign-up, the second a carrier whose payment is confirmed, each once per
# browser. Without a label, that conversion is not sent.
NEXT_PUBLIC_GOOGLE_ADS_ID=
NEXT_PUBLIC_GOOGLE_ADS_SIGNUP_LABEL=
NEXT_PUBLIC_GOOGLE_ADS_SUBSCRIBE_LABEL=

# The website's contact form. RESEND_API_KEY from the client's Resend account, with
# fleetgridus.com verified there (SPF and DKIM). Messages go from CONTACT_FROM (default
# "FleetGrid <noreply@fleetgridus.com>") to CONTACT_TO (default support@fleetgridus.com), with
# the sender's address as reply-to. CONTACT_FORM_SECRET signs the form's timestamp (any long
# random string). Locally, leave them empty: the message is logged, not sent, and a built-in
# secret is used. In production, a missing key or secret makes the form show its error state
# with the support address; it never pretends to send.
RESEND_API_KEY=
CONTACT_TO=
CONTACT_FROM=
CONTACT_FORM_SECRET=

# Contact details shown in the footer, the landing page Contact section, the Help sheet and the
# SMS Terms. Empty means the client's details in src/lib/support.ts (support@fleetgridus.com and
# the Richmond, VA registered agent address). No phone number is shown unless SUPPORT_PHONE is
# set. Address lines are separated by " | ".
SUPPORT_EMAIL=
SUPPORT_PHONE=
BUSINESS_ADDRESS=
